# ---- 凭证(严禁提交) ----
.env.local
**/.env.local

# ---- 源数据(体积超限 + 版权限制, 不入库) ----
参考截图/

# ---- 预处理产物(可由 scripts/ 重新生成, 不入库) ----
web/public/data/
web/public/tiles/

# ---- 前端 ----
node_modules/
dist/
playwright-report/
test-results/
*.local

# ---- 本地开发运行时文件 ----
# 整体忽略 .dev-runtime/（服务端私有索引、锐多宝派生边界、大体积村界/瓦片）。
# 政府驻地坐标表是受控版本化资产，位于仓库内 server/data/，不在此目录。
.dev-runtime/
server/reports/weather-probe-summary.local.json
server/*.log
.runtime-server*.log
.vite-*.log
.tmp-*.png

# ---- Impeccable 实时设计运行时文件（仅保留可复用配置） ----
.impeccable/live/*
!.impeccable/live/
!.impeccable/live/config.json

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- pi 子代理会话运行时文件（不入库） ----
.pi-subagents/

# ---- Python ----
__pycache__/
