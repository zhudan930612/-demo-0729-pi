# APIHz 凭据仅供 Node 服务端读取。不要使用 VITE_*，不要提交真实值。
APIHZ_DEVELOPER_ID=在此填入开发者ID
APIHZ_KEY=在此填入开发者KEY

# 和风天气使用服务端 API KEY 请求头认证。真实值只写入 server/.env.local。
# API Host 在和风天气控制台“设置”中查看，不要使用即将停用的公共 API 地址。
QWEATHER_AUTH_MODE=api-key
QWEATHER_API_HOST=在此填入专属APIHost
QWEATHER_PROJECT_ID=在此填入项目ID
QWEATHER_CREDENTIAL_ID=在此填入凭据ID
QWEATHER_API_KEY=在此填入APIKEY

# 天气行政树和边界产物目录。默认可指向 ../web/public/data；该目录不提交仓库。
WEATHER_DATA_DIR=../web/public/data

# 可选：登录 APIHz 后获得的“查指定经纬度地址-聚合官方版”请求线路。
# 未配置时天气功能使用行政对象/地块/地图点选位置文案降级，不影响和风天气接口。
APIHZ_ADDRESS_URL=

# 可选：仅 loopback 管理请求可用的天气缓存清除令牌。生产环境由密钥管理注入。
WEATHER_ADMIN_TOKEN=

# 可选的非秘密运行配置
PORT=8787
APIHZ_TIMEOUT_MS=8000
APIHZ_MAX_RESPONSE_BYTES=5242880
APIHZ_UPSTREAM_CONCURRENCY=6
APIHZ_CACHE_TTL_MS=30000
APIHZ_CACHE_MAX_ENTRIES=128
APIHZ_RATE_LIMIT_PER_MINUTE=60
APIHZ_RATE_LIMIT_MAX_CLIENTS=2048
QWEATHER_TIMEOUT_MS=8000
QWEATHER_MAX_NETWORK_BYTES=2097152
QWEATHER_MAX_DECODED_BYTES=4194304
QWEATHER_CACHE_MAX_ENTRIES=2048
QWEATHER_UPSTREAM_CONCURRENCY=6
